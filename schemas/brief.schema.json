{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ranatar.github.io/immollimma/schemas/brief.schema.json",
  "title": "Бриф музыкального заказа",
  "description": "Всё, что нужно, чтобы сочинить пьесу без вопросов. Любое поле можно оставить пустым: тогда действует умолчание (default), и в плане будет сказано, что выбрано.",
  "type": "object",
  "properties": {
    "version": {"type": "integer", "default": 1},
    "title": {"type": "string", "default": "", "description": "Название (для файлов и титров)"},
    "purpose": {"enum": ["standalone", "video", "game", "live", "podcast", "other"], "default": "standalone",
                "description": "Назначение: самостоятельная пьеса / к видео / к игре / для живых исполнителей / подложка / другое"},
    "duration_s": {"type": ["number", "null"], "default": null,
                   "description": "Длительность в секундах; пусто — по меткам, без меток — 90 с"},
    "sync": {"type": "object", "default": {},
             "properties": {
               "mode": {"enum": ["none", "cues", "scenes"], "default": "none",
                        "description": "none — без привязки; cues — к файлу меток; scenes — метки по сменам сцен видео"},
               "cues_file": {"type": "string", "default": "cues.json"},
               "video_file": {"type": ["string", "null"], "default": null}}},
    "style": {"type": "object", "default": {},
              "properties": {
                "cards": {"type": "array", "items": {"type": "string"}, "default": [],
                          "description": "Карточки стилей из kit/styles (id); пусто — выберу по описанию"},
                "mood": {"type": "string", "default": "", "description": "Настроение словами"},
                "references": {"type": "string", "default": "",
                               "description": "Ориентиры: композиторы, эпохи, приёмы, что нравится в них (не мелодии)"},
                "avoid": {"type": "string", "default": "", "description": "Чего не хочется"}}},
    "language": {"enum": ["any", "tonal", "modal", "atonal", "mixed"], "default": "any",
                 "description": "Гармонический язык; any — по стилю"},
    "key": {"type": ["string", "null"], "default": null, "description": "Тональность, если важна (например, 'D minor')"},
    "tempo_bpm": {"type": ["number", "null"], "default": null},
    "meter": {"type": ["string", "null"], "default": null, "description": "Размер, например '4/4', '5/8'"},
    "ensemble": {"type": "object", "default": {},
                 "properties": {
                   "size": {"enum": ["auto", "chamber", "orchestra", "strings", "winds", "brass", "percussion", "keys", "custom"],
                            "default": "auto"},
                   "include": {"type": "array", "items": {"type": "string"}, "default": [],
                               "description": "Обязательные инструменты (id из kit/instruments.py или названия партий)"},
                   "exclude": {"type": "array", "items": {"type": "string"}, "default": []},
                   "noises": {"type": "boolean", "default": true, "description": "Можно ли шумы (сирены, цепи, стекло…)"},
                   "processing": {"type": "boolean", "default": true,
                                  "description": "Можно ли обработку: расстройка, глиссандо, реверс, гранулярные облака"}}},
    "library": {"enum": ["auto", "plain", "vsco", "sso"], "default": "auto",
                "description": "auto — прежний семплер VSCO, Sonatina для того, чего у VSCO нет; vsco/sso — всё через SFZ этой библиотеки"},
    "commercial_ad": {"type": "boolean", "default": false,
                      "description": "Музыка для рекламы: тогда только VSCO (CC0), Sonatina запрещена лицензией"},
    "dramaturgy": {"type": "object", "default": {},
                   "properties": {
                     "arc": {"type": "string", "default": "", "description": "Ход формы словами"},
                     "climax_s": {"type": ["number", "null"], "default": null},
                     "ending": {"enum": ["cadence", "fade", "cut", "open"], "default": "cadence"}}},
    "themes": {"type": "array", "default": [], "description": "Свои темы",
               "items": {"type": "object", "properties": {
                 "name": {"type": "string"},
                 "notation": {"type": "string", "description": "ABC или ноты через пробел: 'D4 A4 Bb4 A4'"},
                 "for": {"type": "string", "description": "Кому/чему принадлежит тема"},
                 "transform": {"type": "string", "description": "Как ей меняться"}}}},
    "characters": {"type": "array", "default": [], "description": "Силы и персонажи, у которых будет свой лейтмотив",
                   "items": {"type": "object", "properties": {
                     "name": {"type": "string"}, "description": {"type": "string"}, "evolution": {"type": "string"}}}},
    "silences": {"type": "array", "default": [], "description": "Где обязана быть тишина",
                 "items": {"type": "object", "properties": {"t": {"type": "number"}, "dur": {"type": "number"},
                                                            "note": {"type": "string"}}}},
    "deliver": {"type": "array", "items": {"enum": ["mp3", "wav", "stems", "midi", "musicxml", "pdf", "report", "video"]},
                "default": ["mp3", "midi", "pdf", "report"]},
    "iteration": {"type": "object", "default": {},
                  "properties": {
                    "sketch_first": {"type": "boolean", "default": true,
                                     "description": "Сначала короткий эскиз, потом целиком"},
                    "sketch_seconds": {"type": "number", "default": 60},
                    "ask_before_full": {"type": "boolean", "default": false,
                                        "description": "Ждать одобрения эскиза; false — эскиз и полная версия в одном заходе"}}},
    "notes": {"type": "string", "default": ""}
  }
}
